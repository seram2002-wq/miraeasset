import json
import os
import pickle
import numpy as np
import gc
from pathlib import Path
from sentence_transformers import SentenceTransformer

# 1. 설정 및 폴더 준비
chunk_dir = Path('chunks')
output_dir = Path('faiss_index')
output_dir.mkdir(parents=True, exist_ok=True)

# 2. 모델 로드 (GPU 강제 할당)
print("🤖 AI 모델 로드 중...")
model = SentenceTransformer('jhgan/ko-sroberta-multitask', device='cuda')

# 3. 데이터 읽기
print("📂 청크 데이터 스캔 중...")
all_chunks = []
for file_path in chunk_dir.glob('**/*.jsonl'):
    with open(file_path, 'r', encoding='utf-8-sig', errors='replace') as f:
        for line in f:
            if line.strip():
                try:
                    all_chunks.append(json.loads(line))
                except json.JSONDecodeError:
                    continue

print(f"총 {len(all_chunks)}개의 청크를 발견했습니다.")

# 4. 🔥 안전한 분할 임베딩 (10만 개 단위로 끊어서 저장)
BLOCK_SIZE = 100000
total_blocks = (len(all_chunks) + BLOCK_SIZE - 1) // BLOCK_SIZE

print(f"⚡ 총 {total_blocks}번으로 나누어 안전하게 임베딩을 시작합니다!")

for b in range(total_blocks):
    print(f"\n--- [ {b+1} / {total_blocks} 번째 블록 처리 중 ] ---")

    # 10만 개씩 자르기
    start_idx = b * BLOCK_SIZE
    end_idx = min((b + 1) * BLOCK_SIZE, len(all_chunks))
    current_block = all_chunks[start_idx:end_idx]

    # 💡 [수정됨] 일반 text 대신 목차가 포함된 embedding_text를 우선적으로 가져옵니다!
    # (만약 embedding_text가 없는 구버전 데이터라면 text를 가져오도록 안전 처리)
    texts = [chunk.get('embedding_text', chunk.get('text', '')) for chunk in current_block]
    
    embeddings = model.encode(texts, batch_size=128, show_progress_bar=True)

    # 즉시 파일로 저장 (블록 번호를 붙여서 여러 개로 저장)
    np.save(output_dir / f'embeddings_block_{b}.npy', np.array(embeddings).astype('float32'))
    with open(output_dir / f'metadata_block_{b}.pkl', 'wb') as f:
        pickle.dump(current_block, f)

    print(f"💾 {b+1}번째 블록 저장 완료! 메모리를 청소합니다.")

    # ⭐ 램(RAM) 터짐 방지: 다 쓴 데이터 삭제 및 메모리 청소
    del current_block, texts, embeddings
    gc.collect()

print("\n🎉✅ 1단계 완벽하게 완료! 모든 데이터가 안전하게 분할 저장되었습니다!")

import faiss
import numpy as np
import pickle
import glob
import os
from pathlib import Path

# 1. 설정 및 파일 스캔
output_dir = Path('faiss_index')
faiss_index_path = output_dir / 'index.faiss'
final_metadata_path = output_dir / 'metadata_final.pkl'

# 저장된 블록 파일들을 순서대로 찾기
npy_files = sorted(glob.glob(str(output_dir / 'embeddings_block_*.npy')),
                   key=lambda x: int(os.path.basename(x).split('_')[2].split('.')[0]))
pkl_files = sorted(glob.glob(str(output_dir / 'metadata_block_*.pkl')),
                   key=lambda x: int(os.path.basename(x).split('_')[2].split('.')[0]))

print(f"🔍 총 {len(npy_files)}개의 임베딩 블록을 발견했습니다. 조립을 시작합니다!")

# 2. FAISS 인덱스 초기화 (첫 번째 파일의 차원 수 기준)
first_block = np.load(npy_files[0])
dimension = first_block.shape[1]
index = faiss.IndexFlatL2(dimension)
print(f"⚙️ FAISS 검색 엔진 초기화 완료 (차원 수: {dimension})")

final_metadata = []

# 3. 블록들을 하나씩 불러와서 메모리 안전하게 합치기
for i, (npy_file, pkl_file) in enumerate(zip(npy_files, pkl_files)):
    print(f"🧩 [{i+1}/{len(npy_files)}] 블록 조립 중...")

    # 임베딩 추가
    embeddings = np.load(npy_file)
    index.add(embeddings)

    # 메타데이터 병합
    with open(pkl_file, 'rb') as f:
        metadata = pickle.load(f)
        final_metadata.extend(metadata)

# 4. 찐 최종 파일 저장
print("\n💾 찐 최종 FAISS 인덱스 및 통합 메타데이터 저장 중...")
faiss.write_index(index, str(faiss_index_path))

with open(final_metadata_path, 'wb') as f:
    pickle.dump(final_metadata, f)

print(f"🎉 2단계 완료! 완벽한 검색 엔진이 완성되었습니다!")
print(f"👉 검색 엔진 파일: {faiss_index_path}")
print(f"👉 통합 메타데이터: {final_metadata_path}")

